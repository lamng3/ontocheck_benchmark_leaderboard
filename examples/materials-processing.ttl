    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty mds:hasProcessingParameter ;
            owl:someValuesFrom mds:FoilType ],
        [ a owl:Restriction ;
            owl:onProperty mds:hasProcessingParameter ;
            owl:someValuesFrom mds:TapeType ],
        mds:MaterialsProcessing ;
    skos:altLabel "Mechanical Exfoliation",
        "Scotch Tape Method",
        "Tape Exfoliation" ;

            owl:onProperty mds:hasProcessingParameter ;
            owl:someValuesFrom mds:ReactionTemperature ],
        [ a owl:Restriction ;
            owl:onProperty mds:hasProcessingParameter ;
            owl:someValuesFrom mds:ReactionPressure ],
        [ a owl:Restriction ;
            owl:onProperty mds:hasProcessingParameter ;
            owl:someValuesFrom mds:Solvent ],
        [ a owl:Restriction ;
            owl:onProperty mds:hasProcessingParameter ;
            owl:someValuesFrom mds:GrowthTime ],
        mds:MaterialsProcessing ;
    skos:altLabel "Hydrothermal Processing",
        "Solvothermal Synthesis" ;

@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix mds: <https://cwrusdle.bitbucket.io/mds/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

qudt:hasUnit a owl:DatatypeProperty ;
    rdfs:domain mds:SpatialResolution ;
    rdfs:range xsd:string ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain "Raster" .

qudt:numericValue a owl:DatatypeProperty ;
    rdfs:domain mds:SpatialResolution ;
    rdfs:range xsd:decimal ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain "Raster" .

mds:acquiredOn a owl:ObjectProperty ;
    rdfs:domain mds:GeospatialRaster ;
    rdfs:range mds:AcquisitionDate ;
    skos:definition "Indicates the datetime that the data was acquired " ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain "Raster" .

mds:containsBand a owl:ObjectProperty ;
    rdfs:domain mds:GeospatialRaster,
        mds:Sensor ;
    rdfs:range mds:Band ;
    skos:definition "Indicates the band contained by the raster.",
        "Indicates the band contained by the sensor." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " ",
        "Raster" .

mds:containsBandCategory a owl:DatatypeProperty ;
    rdfs:domain mds:Sensor ;
    rdfs:range xsd:string ;
    skos:definition "Describes the band category or categories of the sensor." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " " .

mds:containsGeospatialProperty a owl:ObjectProperty ;
    rdfs:domain mds:GeospatialRaster ;
    rdfs:range mds:GeospatialProperty ;
    skos:definition "Indicates which geospatial property is represented by the data." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain "Raster" .

mds:containsSensor a owl:ObjectProperty ;
    rdfs:domain mds:Satellite ;
    rdfs:range mds:Sensor ;
    skos:definition "Indicates the sensor contained by the satellite." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " " .

mds:generatedBySatellite a owl:ObjectProperty ;
    rdfs:domain mds:GeospatialRaster ;
    rdfs:range mds:Satellite ;
    skos:definition "Indicates the satellite that generated the data." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain "Raster" .

mds:generatedBySensor a owl:ObjectProperty ;
    rdfs:domain mds:GeospatialRaster ;
    rdfs:range mds:Sensor ;
    skos:definition "Indicates which instrument or sensor on a satellite generated the data." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain "Raster" .

mds:hasApogeeAltitude a owl:DatatypeProperty ;
    rdfs:domain mds:SatelliteAltitude ;
    rdfs:range xsd:decimal ;
    skos:definition "Denotes the apogee altitude value of the satellite altitude." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " " .

mds:hasBandCategory a owl:DatatypeProperty ;
    rdfs:domain mds:Band ;
    rdfs:range xsd:string ;
    skos:definition "Describes the category of the band." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " " .

mds:hasBandCommonName a owl:DatatypeProperty ;
    rdfs:domain mds:Band ;
    rdfs:range xsd:string ;
    skos:definition "Denotes the common name of the band." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " " .

mds:hasBandDescription a owl:ObjectProperty ;
    rdfs:domain mds:Band ;
    rdfs:range mds:BandDescription ;
    skos:definition "Specifies a description or categorization of the band." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " " .

mds:hasCentroid a owl:ObjectProperty ;
    rdfs:domain mds:Geohash ;
    rdfs:range mds:Centroid ;
    skos:definition "indicates the center point of the geohash in latitude and longitude." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " " .

mds:hasEastNeighbor a owl:ObjectProperty ;
    rdfs:domain mds:Geohash ;
    rdfs:range mds:Geohash ;
    skos:definition "Indicates the geohash to the east of the current geohash." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " " .

mds:hasEndedOn a owl:ObjectProperty ;
    rdfs:domain mds:Satellite ;
    rdfs:range mds:EndOfLifeDate ;
    skos:definition "Specifies the end of life date of the satellite." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " " .

mds:hasFileFormat a owl:ObjectProperty ;
    rdfs:domain mds:GeospatailRaster ;
    rdfs:range mds:FileFormat ;
    skos:definition "Indicates the file format of the data." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain "Raster" .

mds:hasGeohashPrecision a owl:DatatypeProperty ;
    rdfs:domain mds:Geohash ;
    rdfs:range xsd:integer ;
    skos:definition "Indicates the level of precision of the geohash " ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " " .

mds:hasGeospatialBoundingBox a owl:ObjectProperty ;
    rdfs:domain mds:Geohash,
        mds:GeospatialRaster ;
    rdfs:range mds:GeospatialRegionBoundingBox ;
    skos:definition "Indicates the bounding box encapsulated by the geohash.",
        "Indicates the bounding box encapsulated by the geospatial data." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " ",
        "Raster" .

mds:hasInstrumentStatus a owl:ObjectProperty ;
    rdfs:domain mds:Sensor ;
    rdfs:range mds:InstrumentStatus ;
    skos:definition "Specifies the instrument status of the sensor." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " " .

mds:hasMaximumLatitude a owl:DatatypeProperty ;
    rdfs:domain mds:GeospatialRegionBoundingBox ;
    rdfs:range xsd:decimal ;
    skos:definition "Denotes the maximum latitudinal value of a geospatial region bounding box." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " ",
        "Raster" .

mds:hasMaximumLongitude a owl:DatatypeProperty ;
    rdfs:domain mds:GeospatialRegionBoundingBox ;
    rdfs:range xsd:decimal ;
    skos:definition "Denotes the maximum longitudinal value of a geospatial region bounding box." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " ",
        "Raster" .

mds:hasMaximumWavelength a owl:DatatypeProperty ;
    rdfs:domain mds:WavelengthRange ;
    rdfs:range xsd:decimal ;
    skos:definition "Denotes the maximum value of the wavelength range." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " " .

mds:hasMinimumLatitude a owl:DatatypeProperty ;
    rdfs:domain mds:GeospatialRegionBoundingBox ;
    rdfs:range xsd:decimal ;
    skos:definition "Denotes the minimum latitudinal value of a geospatial region bounding box." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " ",
        "Raster" .

mds:hasMinimumLongitude a owl:DatatypeProperty ;
    rdfs:domain mds:GeospatialRegionBoundingBox ;
    rdfs:range xsd:decimal ;
    skos:definition "Denotes the minimum longitudinal value of a geospatial region bounding box." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " ",
        "Raster" .

mds:hasMinimumWavelength a owl:DatatypeProperty ;
    rdfs:domain mds:WavelengthRange ;
    rdfs:range xsd:decimal ;
    skos:definition "Denotes the minimum value of the wavelength range." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " " .

mds:hasMission a owl:ObjectProperty ;
    rdfs:domain mds:Satellite ;
    rdfs:range mds:Mission ;
    skos:definition "Indicates the mission of the satellite." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " " .

mds:hasNorthNeighbor a owl:ObjectProperty ;
    rdfs:domain mds:Geohash ;
    rdfs:range mds:Geohash ;
    skos:definition "Indicates the geohash to the north of the current geohash." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " " .

mds:hasNortheastNeighbor a owl:ObjectProperty ;
    rdfs:domain mds:Geohash ;
    rdfs:range mds:Geohash ;
    skos:definition "Indicates the geohash to the northeast of the current geohash." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " " .

mds:hasNorthwestNeighbor a owl:ObjectProperty ;
    rdfs:domain mds:Geohash ;
    rdfs:range mds:Geohash ;
    skos:definition "Indicates the geohash to the northwest of the current geohash." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " " .

mds:hasOperationalStatus a owl:ObjectProperty ;
    rdfs:domain mds:Satellite ;
    rdfs:range mds:MissionStatus ;
    skos:definition "Specifies the operational status of the satellite's mission." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " " .

mds:hasOrbitAltitude a owl:DatatypeProperty ;
    rdfs:domain mds:OrbitType ;
    rdfs:range xsd:decimal ;
    skos:definition "Denotes the orbit altitude value of the orbit type." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " " .

mds:hasOrbitalPeriod a owl:DatatypeProperty ;
    rdfs:domain mds:OrbitType ;
    rdfs:range xsd:decimal ;
    skos:definition "Denotes the orbital period value of the orbit type." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " " .

mds:hasOrbitalType a owl:ObjectProperty ;
    rdfs:domain mds:Satellite ;
    rdfs:range mds:OrbitType ;
    skos:definition "Specifies the orbital type of the satellite." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " " .

mds:hasOwner a owl:ObjectProperty ;
    rdfs:domain mds:GeospatialRaster,
        mds:Satellite ;
    rdfs:range mds:Owner ;
    skos:definition "Indicates the original owner of the data.",
        "Indicates the owner of the satellite." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " ",
        "Raster" .

mds:hasPerigeeAltitude a owl:DatatypeProperty ;
    rdfs:domain mds:SatelliteAltitude ;
    rdfs:range xsd:decimal ;
    skos:definition "Denotes the perigee altitude value of the satellite altitude." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " " .

mds:hasPixelHeight a owl:DatatypeProperty ;
    rdfs:domain mds:PixelInformation ;
    rdfs:range xsd:decimal ;
    skos:definition "Indicates the number of pixels that represent the height of the raster" ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain "Raster" .

mds:hasPixelInformation a owl:ObjectProperty ;
    rdfs:domain mds:GeospatialRaster ;
    rdfs:range mds:PixelInformation ;
    skos:definition "Specifies information about the raster pixels." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain "Raster" .

mds:hasPixelResolution a owl:DatatypeProperty ;
    rdfs:domain mds:PixelInformation ;
    rdfs:range xsd:decimal ;
    skos:definition "Indicates the size of a pixel in terms of the units of the raster" ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain "Raster" .

mds:hasPixelWidth a owl:DatatypeProperty ;
    rdfs:domain mds:PixelInformation ;
    rdfs:range xsd:decimal ;
    skos:definition "Indicates the number of pixels that represent the width of the raster" ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain "Raster" .

mds:hasProcessingLevel a owl:DatatypeProperty ;
    rdfs:domain mds:ProcessingAlgorithm ;
    rdfs:range xsd:string ;
    skos:definition "Describes the level to which the data has been processed." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain "Raster" .

mds:hasProcessingQuality a owl:DatatypeProperty ;
    rdfs:domain mds:ProcessingAlgorithm ;
    rdfs:range xsd:string ;
    skos:definition "Describes the quality of the processing done to the data." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain "Raster" .

mds:hasProcessingStatus a owl:DatatypeProperty ;
    rdfs:domain mds:ProcessingAlgorithm ;
    rdfs:range xsd:string ;
    skos:definition "Indicates the status of the processing on the data." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain "Raster" .

mds:hasSatelliteAltitude a owl:ObjectProperty ;
    rdfs:domain mds:Satellite ;
    rdfs:range mds:SatelliteAltitude ;
    skos:definition "Specifies the altitude of the satellite." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " " .

mds:hasSatelliteCommonName a owl:DatatypeProperty ;
    rdfs:domain mds:Satellite ;
    rdfs:range xsd:string ;
    skos:definition "Denotes the common name of the satellite." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " " .

mds:hasSatelliteDetails a owl:DatatypeProperty ;
    rdfs:domain mds:Satellite ;
    rdfs:range xsd:string ;
    skos:definition "Describes specific details of the satellite." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " " .

mds:hasSensorCommonName a owl:DatatypeProperty ;
    rdfs:domain mds:Sensor ;
    rdfs:range xsd:string ;
    skos:definition "Denotes the common name of the sensor." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " " .

mds:hasSensorDetails a owl:DatatypeProperty ;
    rdfs:domain mds:Sensor ;
    rdfs:range xsd:string ;
    skos:definition "Describes specific details of the sensor." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " " .

mds:hasSouthNeighbor a owl:ObjectProperty ;
    rdfs:domain mds:Geohash ;
    rdfs:range mds:Geohash ;
    skos:definition "Indicates the geohash to the south of the current geohash." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " " .

mds:hasSoutheastNeighbor a owl:ObjectProperty ;
    rdfs:domain mds:Geohash ;
    rdfs:range mds:Geohash ;
    skos:definition "Indicates the geohash to the southeast of the current geohash." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " " .

mds:hasSouthwestNeighbor a owl:ObjectProperty ;
    rdfs:domain mds:Geohash ;
    rdfs:range mds:Geohash ;
    skos:definition "Indicates the geohash to the southwest of the current geohash." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " " .

mds:hasSpatialResolution a owl:ObjectProperty ;
    rdfs:domain mds:Band,
        mds:GeospatialRaster ;
    rdfs:range mds:SpatialResolution ;
    skos:definition "Specifies the spatial resolution of the band.",
        "Specifies the spatial resolution of the data." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " ",
        "Raster" .

mds:hasSpectralResolution a owl:ObjectProperty ;
    rdfs:domain mds:Band ;
    rdfs:range mds:SpectralResolution ;
    skos:definition "Specifies the spectral resolution of the band." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " " .

mds:hasSwathWidth a owl:DatatypeProperty ;
    rdfs:domain mds:Band ;
    rdfs:range xsd:decimal ;
    skos:definition "Denotes the swath width value of the band." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " " .

mds:hasTemporalResolution a owl:ObjectProperty ;
    rdfs:domain mds:Band,
        mds:GeospatialRaster ;
    rdfs:range mds:TemporalResolution ;
    skos:definition "Specifies the temporal resolution of the band.",
        "Specifies the temporal resolution of the data." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " ",
        "Raster" .

mds:hasWavelengthRange a owl:ObjectProperty ;
    rdfs:domain mds:Band ;
    rdfs:range mds:WavelengthRange ;
    skos:definition "Indicates the wavelength range of the band." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " " .

mds:hasWestNeighbor a owl:ObjectProperty ;
    rdfs:domain mds:Geohash ;
    rdfs:range mds:Geohash ;
    skos:definition "Indicates the geohash to the west of the current geohash." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " " .

mds:launchedFrom a owl:ObjectProperty ;
    rdfs:domain mds:Satellite ;
    rdfs:range mds:LaunchSite ;
    skos:definition "Specifies the site where the satellite is launched from." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " " .

mds:launchedOn a owl:ObjectProperty ;
    rdfs:domain mds:Satellite ;
    rdfs:range mds:LaunchDate ;
    skos:definition "Specifies the launch date of the satellite." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " " .

mds:mountedOn a owl:ObjectProperty ;
    rdfs:domain mds:Sensor ;
    rdfs:range mds:Satellite ;
    skos:definition "Indicates the satellite on which the sensor is mounted on." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " " .

mds:occupiesSpatialRegion a owl:ObjectProperty ;
    rdfs:domain mds:GeospatialRaster,
        mds:GeospatiotemporalData ;
    rdfs:range mds:Geohash ;
    skos:definition "Indicates the geohash spatial region occupied by the data scope." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " ",
        "Raster" .

mds:ownedByAgency a owl:ObjectProperty ;
    rdfs:domain mds:Satellite,
        mds:Sensor ;
    rdfs:range mds:Agency ;
    skos:definition "Indicates the agency that owns the object.",
        "Indicates the agency that owns the satellite or sensor instrument." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " " .

mds:processedUsing a owl:ObjectProperty ;
    rdfs:domain mds:GeospatialRaster ;
    rdfs:range mds:ProcessingAlgorithm ;
    skos:definition "Specifies how the data was processed." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain "Raster" .

mds:producedBy a owl:ObjectProperty ;
    rdfs:domain mds:Band ;
    rdfs:range mds:Sensor ;
    skos:definition "Specifies the sensor that produced the band." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " " .

mds:usesCompressionMethod a owl:DatatypeProperty ;
    rdfs:domain mds:GeospatialRaster ;
    rdfs:range xsd:string ;
    skos:definition "Indicates the compression method  for the data." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain "Raster" .

mds:usesLicense a owl:ObjectProperty ;
    rdfs:domain mds:GeospatialRaster ;
    rdfs:range mds:License ;
    skos:definition "Designates the license by which the data was collected." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain "Raster" .

mds:usesSpatialReferenceSystem a owl:ObjectProperty ;
    rdfs:domain mds:Geohash,
        mds:GeospatialRaster ;
    rdfs:range mds:SpatialReferenceSystem ;
    skos:definition "Indicates the spatial reference system or coordinate reference system used by the data" ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " ",
        "Raster" .

mds:AcquisitionDate a owl:Class ;
    rdfs:label "AcquisitionDate" ;
    rdfs:subClassOf cco:ont00000529 ;
    skos:altLabel "CaptureDate",
        "DataCollectionDate",
        "ObservationDate" ;
    skos:definition "Datetime when the sensing instrument collected the data used to create the raster image." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain "Raster" .

mds:Agency a owl:Class ;
    rdfs:label "Agency" ;
    rdfs:subClassOf cco:ont00001017 ;
    skos:altLabel "SatelliteAgency" ;
    skos:definition "The lead agency for the satellite mission." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " " .

mds:BandDescription a owl:Class ;
    rdfs:label "BandDescription" ;
    rdfs:subClassOf obo:BFO_0000019 ;
    skos:altLabel "OperationalBandDescription",
        "WavebandDescription" ;
    skos:definition "A description of the waveband captured by the sensor." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " " .

mds:Elevation a owl:Class ;
    rdfs:label "Elevation" ;
    rdfs:subClassOf mds:GeospatialProperty ;
    skos:altLabel "DigitalElevationModel",
        "HeightAboveSeaLevel" ;
    skos:definition "Elevation above sea level.",
        "Geospatial property describing the height of a land surface above sea level." ;
    skos:exactMatch mds:Elevation ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain "Raster" .

mds:EndOfLifeDate a owl:Class ;
    rdfs:label "EndOfLifeDate" ;
    rdfs:subClassOf cco:ont00000529 ;
    skos:altLabel "EOLDate" ;
    skos:definition "The past, planned or projected end of life  date for the mission." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " " .

mds:FileFormat a owl:Class ;
    rdfs:label "FileFormat" ;
    rdfs:subClassOf cco:ont00000686 ;
    skos:altLabel "DataFormat",
        "FileExtension",
        "FileType" ;
    skos:definition "Type of file storing the data ." ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain "Raster" .

mds:Instrument a owl:Class,
        owl:NamedIndividual,
        owl:ObjectProperty ;
    rdfs:label "Instrument" ;
    rdfs:domain mds:Sensor ;
    rdfs:range mds:InstrumentType ;
    skos:definition "A NicoletFTIR-OpticalSpectroscopy for chemical analysis",
        "Indicates the instrument type for the sensor." ;
    skos:exactMatch mds:Instrument ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " " .

mds:InstrumentStatus a owl:Class ;
    rdfs:label "InstrumentStatus" ;

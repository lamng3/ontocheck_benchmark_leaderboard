    mds:hasStudyStage " " ;
    mds:hasSubDomain " ",
        "Raster" .

cco:ont00001764 a owl:DatatypeProperty,
        owl:NamedIndividual ;
    rdfs:label "has longitude value"@en ;
    rdfs:domain mds:Centroid ;
    rdfs:range xsd:decimal ;
    skos:definition "A Data Property that has as its range the longitude value from some Geospatial Location coordinates set expressed in decimal degrees."@en ;
    skos:exactMatch cco:ont00001764 ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " " .

cco:ont00001766 a owl:DatatypeProperty,
        owl:NamedIndividual ;
    rdfs:label "has latitude value"@en ;
    rdfs:domain mds:Centroid ;
    rdfs:range xsd:decimal ;
    skos:definition "A Data Property that has as its range the latitude value from some Geospatial Location coordinates set expressed in decimal degrees."@en ;
    skos:exactMatch cco:ont00001766 ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " " .

cco:ont00001908 a owl:NamedIndividual,
        owl:ObjectProperty ;
    rdfs:label "uses time zone identifier"@en ;
    rdfs:domain mds:GeospatialRaster,
        cco:ont00000253 ;
    rdfs:range mds:TimeZone,
        cco:ont00000829 ;
    skos:definition "Indicates the time zone used by the data.",
        "x uses_time_zone_identifier y iff x is an instance of Information Bearing Entity and y is an instance of Time Zone Identifier, such that y designates the spatial region associated with the time zone mentioned in x."@en ;
    skos:exactMatch cco:ont00001908 ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain "Raster" .

xsd:integer skos:exactMatch xsd:integer .


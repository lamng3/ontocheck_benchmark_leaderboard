    skos:exactMatch mds:Band ;
    mds:hasDomain "Geo" ;
    mds:hasStudyStage " " ;
    mds:hasSubDomain " " .

mds:Sensor a owl:Class ;
    rdfs:label "Sensor" ;
    rdfs:subClassOf cco:ont00000771 ;
    skos:altLabel "EarthObservationInstrument",
        "Imager",
        "ImagingInstrument",
        "Instrument",
        "RemoteSensingObject",
        "RemoteSensor",
        "SensorID",
        "SensorInstrument" ;
